	</ItemGroup>


	<ItemGroup>
		<ProjectReference Include="..\..\..\src\BlingoEngine.LGodot\BlingoEngine.LGodot.csproj" />
		<ProjectReference Include="..\..\..\src\BlingoEngine\BlingoEngine.csproj" />
		<ProjectReference Include="..\Blingo.PacMan.Core\Blingo.PacMan.Core.csproj" />
	</ItemGroup>


	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<Exec Command="echo CONFIG=$(Configuration)  DEFS=$(DefineConstants)" />
	</Target>


</Project>
